# Mac local setup: copy this file to .env at the repository root.
# Instructions: DOCS/deployment/mac-local-setup.md
# Ollama runs directly on macOS; application services run in Docker Desktop.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
VECTOR_DIMENSION=1024
OLLAMA_BATCH_SIZE=50

LLM_PROVIDER=ollama
# Use qwen3:8b as the shared starting point. If another compatible model is
# already available in Ollama, set its exact tag here, e.g. qwen3.5:27b.
OLLAMA_MODEL=qwen3:8b
LLM_DEFAULT_ALIAS=default
LLM_TIMEOUT=600
# This file is copied into the LLM image by its existing Dockerfile.
MODELS_CONFIG_PATH=/app/llm_service/models.local.yaml

INGESTION_NODE_PAGE_SIZE=32
INGESTION_EMBED_BATCH_SIZE=128
INGESTION_EMBED_MAX_BYTES=262144
INGESTION_MAX_ARTIFACT_BYTES=1048576
