# ============================================================================
# rag-foundry-universal — environment template
#
# Copy to `.env` (git-ignored) at the repo root. docker-compose.yml loads it
# via `env_file: ./.env` for ingestion_service, vector_store_service,
# llm_service, and rag_orchestrator.
#
# Note: DATABASE_URL is deliberately NOT set here for the Docker stack —
# docker-compose.yml injects it directly into ingestion_service and
# vector_store_service (postgres:5432/ingestion_db, the container-internal
# hostname/port — unaffected by the host port mapping below). Only set it
# below when running services/alembic/tests outside Docker.
# ============================================================================

# ----------------------------------------------------------------------------
# Embeddings — used by ingestion_service, vector_store_service, rag_orchestrator
# ----------------------------------------------------------------------------
# Embedder backend: "ollama" (real embeddings) or "mock" (tests/dev without Ollama)
EMBEDDING_PROVIDER=ollama
# Ollama endpoint as seen from inside containers (host.docker.internal = host machine)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Embedding model — must be pre-pulled in Ollama; mxbai-embed-large produces 1024-dim vectors
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
# Number of texts sent per embedding batch request
OLLAMA_BATCH_SIZE=50
# Vector dimension — must match OLLAMA_EMBED_MODEL output and the pgvector schema
VECTOR_DIMENSION=1024

# ----------------------------------------------------------------------------
# LLM generation — used by llm_service (LiteLLM-backed since WP-M1)
# ----------------------------------------------------------------------------
# Legacy default-provider knob (kept for backward compat; the model
# registry in llm_service/models.yaml is the real menu)
LLM_PROVIDER=ollama
# Default chat/generation model — must be pre-pulled in Ollama; becomes
# the `default` alias (ollama/<OLLAMA_MODEL>) unless models.yaml overrides
OLLAMA_MODEL=phi4-mini:latest
# Default LiteLLM request timeout in seconds (per-alias overrides in models.yaml)
#LLM_TIMEOUT=120
# Path to the model-alias registry (default: llm_service/models.yaml)
#MODELS_CONFIG_PATH=/app/llm_service/models.yaml
# Optional remote Ollama endpoint (issue #43) — machine-specific, so the
# committed models.yaml only activates it when these are set here (this
# file's real counterpart, .env, is gitignored). Setting the base URL
# creates the `remote` alias + `tailscaleollamalinux` endpoint;
# LLM_DEFAULT_ALIAS=remote makes it the default generation route with
# automatic fallback to the host-local Ollama.
#REMOTE_OLLAMA_BASE_URL=http://<your-tailscale-ip>:11434
#REMOTE_OLLAMA_MODEL=Qwen3:4b
#LLM_DEFAULT_ALIAS=remote
# Per-step model for /v1/summarize (small + fast; rides the remote endpoint)
#SUMMARIZE_MODEL=granite4:350m
# Cloud provider API keys — env-only, read natively by LiteLLM.
# NEVER commit real keys; requests can never carry keys.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GROQ_API_KEY=
# issue #46: first-class Groq / NVIDIA NIM / OpenRouter. Setting these
# activates the groq_fast/groq_smart/groq_reasoning, nim_fast/nim_smart,
# and openrouter_free aliases in llm_service/models.yaml (they're always
# listed in GET /v1/models regardless, but calls fail without the key).
#NVIDIA_API_KEY=
#OPENROUTER_API_KEY=
# Only needed for a self-hosted NVIDIA NIM deployment -- the nvidia_nim
# endpoint defaults to NVIDIA's public API otherwise.
#NVIDIA_NIM_API_BASE=

# WP-M7: shared secret for the model-policy WRITE endpoints only
# (PUT/DELETE /v1/admin/policy/{slot}) -- lets you switch which concrete
# model backs a slot (default/fast/smart/reasoning/...) at runtime, no
# code change or redeploy. Read access (GET /v1/models) stays open
# regardless. Unset -> writes are disabled (503), not silently
# unauthenticated.
#LLM_ADMIN_SECRET=

# ----------------------------------------------------------------------------
# Document ingestion options — used by ingestion_service
# ----------------------------------------------------------------------------
# Use Docling for PDF parsing; set to false to fall back to PyMuPDF
#DOCLING_ENABLED=true
# OCR backend for scanned documents (default: tesseract)
#OCR_PROVIDER=tesseract
# WP-L5 (DOCS/audit/03-Multi-Language-Graph-Plan.md, issue #134): use the
# tree-sitter Python extractor instead of the legacy ast one. Default
# False keeps ast as the production extractor until parity is proven.
#PYTHON_TREESITTER_ENABLED=false
# When true (default), a tree-sitter Python parse exception is caught and
# automatically retried with the legacy ast extractor — set false only to
# surface raw tree-sitter failures during the parity/rollout window.
#PYTHON_TREESITTER_AUTO_FALLBACK=true

# ----------------------------------------------------------------------------
# Database — only needed when running OUTSIDE Docker (alembic, local pytest)
# ----------------------------------------------------------------------------
# Main DB from the host (host port 5434 — see docker-compose.yml; kept off
# the default 5432 to avoid clashing with other local Postgres containers):
#DATABASE_URL=postgresql://ingestion_user:ingestion_pass@localhost:5434/ingestion_db
# Test DB (docker-compose.test.yml, port 5433) — see .env.test:
#DATABASE_URL=postgresql://ingestion_user:ingestion_pass@localhost:5433/ingestion_test

# ----------------------------------------------------------------------------
# Service URLs — Docker-network defaults are baked into the code
# (shared/config/service_urls.py and each service's core/config.py).
# Override only when running services outside the compose network.
# ----------------------------------------------------------------------------
#INGESTION_SERVICE_URL=http://ingestion_service:8000
#VECTOR_STORE_URL=http://vector_store_service:8002
#VECTOR_STORE_SERVICE_URL=http://vector_store_service:8002
#LLM_SERVICE_URL=http://llm_service:8000
#RAG_ORCHESTRATOR_URL=http://rag_orchestrator:8000

# ----------------------------------------------------------------------------
# Gradio UI — set by docker-compose.yml for the container; override for a
# locally-run UI hitting the published host ports.
# ----------------------------------------------------------------------------
#API_BASE_URL=http://localhost:8001
#RAG_API_BASE_URL=http://localhost:8004
