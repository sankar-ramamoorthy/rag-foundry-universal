{
  "name": "foundry-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Foundry product frontend (ADR-057). The API client is generated from openapi/product.openapi.json.",
  "scripts": {
    "generate:api": "openapi-typescript openapi/product.openapi.json -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
