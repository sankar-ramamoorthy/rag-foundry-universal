        {
          "chunk_id": "9a8db0ee-59a0-4d1f-bf9f-9ed998f54cc9",
          "text": "A standard incident goes to the queue owner within 2 hours of classification. The clock starts at classification, not when the user first reports the issue.",
          "document_id": "91958de0-38c1-4b98-8241-efcd12569476",
          "score": 0.0,
          "metadata": {
